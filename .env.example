# Smart Ambulance Locator — Environment Configuration
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# ─── Flask ───────────────────────────────────────────────────
FLASK_ENV=development
SECRET_KEY=replace_with_a_long_random_string_at_least_32_chars

# ─── Database (MySQL / MariaDB) ───────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_mysql_username
DB_PASSWORD=your_mysql_password
DB_NAME=smart_ambulance

# ─── Google Maps ─────────────────────────────────────────────
# Server key: enable "Routes API". Restrict by IP.
GOOGLE_MAPS_API_KEY=
# Browser key: enable "Maps JavaScript API" + "Geocoding API". Restrict by HTTP referrer.
GOOGLE_MAPS_BROWSER_KEY=

# ─── Gemini AI ────────────────────────────────────────────────
GEMINI_API_KEY=
# Example: gemini-1.5-flash-latest
GEMINI_MODEL=gemini-1.5-flash-latest

# ─── CORS ─────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5000
