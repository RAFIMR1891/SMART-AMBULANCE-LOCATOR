# Smart Ambulance Locator — Environment Configuration
# Copy this file to .env and fill in your credentials.
# Never commit .env to version control.

# Flask
FLASK_ENV=development
SECRET_KEY=REPLACE-WITH-RANDOM-32-CHAR-SECRET-KEY

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=YOUR_MYSQL_ROOT_PASSWORD
DB_NAME=smart_ambulance

# Google Maps Routes API (optional — for traffic-aware ETA)
# Enable "Routes API" in Google Cloud Console
# Falls back to Haversine straight-line distance without this key
GOOGLE_MAPS_API_KEY=

# Google Maps JavaScript API (optional — for browser map embeds)
# OpenStreetMap / Leaflet is used by default (no key needed)
GOOGLE_MAPS_BROWSER_KEY=

# Google Gemini AI (optional — for AI-assisted text summaries)
# Get your key at: https://aistudio.google.com/app/apikey
# The app works without this key; the AI panel will show a warning
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash-latest

# CORS — comma-separated allowed origins
ALLOWED_ORIGINS=http://localhost:5000

# Dispatch mode default (stored in DB; this is for documentation only)
# Actual mode is managed via the admin dashboard, not this variable
DISPATCH_MODE_DEFAULT=manual
